# ----------------------------------------------------------------------------
# Marketra environment variables
# Copy this file to ".env.local" and fill in the required values.
# Never commit real secrets.
#
# Only variables prefixed with NEXT_PUBLIC_ may be exposed to the browser.
# ----------------------------------------------------------------------------

# ---- Application ----
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Marketra

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side service role key. MUST NEVER appear in NEXT_PUBLIC_ or browser code.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Closed beta ----
# Options: open | invite_only | allowlist | disabled
SIGNUP_MODE=invite_only
# Comma-separated exact emails or domains prefixed with @. Server-only.
SIGNUP_ALLOWLIST=

# ---- AI provider ----
# Default selected AI provider. mock works without any credentials.
DEFAULT_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_PROMPT_VERSION=v1

# ---- Lead provider ----
# Options: mock | manual | csv | external
DEFAULT_LEAD_PROVIDER=mock
EXTERNAL_LEAD_API_KEY=
EXTERNAL_LEAD_BASE_URL=

# ---- Company discovery provider ----
# Options: mock | external (external not implemented in Phase 6)
DEFAULT_COMPANY_DISCOVERY_PROVIDER=mock

# ---- Outreach provider ----
# Options: mock | openai (uses the OpenAI settings above)
DEFAULT_OUTREACH_PROVIDER=mock

# ---- Market intelligence provider ----
DEFAULT_MARKET_INTELLIGENCE_PROVIDER=mock
MARKET_INTELLIGENCE_API_KEY=
MARKET_INTELLIGENCE_BASE_URL=

# ---- Billing provider ----
# Options: mock | stripe | paytr | iyzico
DEFAULT_BILLING_PROVIDER=mock
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# PayTR
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# ---- Email provider ----
# Options: mock | smtp
DEFAULT_EMAIL_PROVIDER=mock
EMAIL_FROM="Marketra <no-reply@marketra.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=10000
SMTP_MAX_RETRIES=1
# Operator-controlled recipient used only by the opt-in SMTP smoke test.
SMTP_SMOKE_TO=

# ---- Analytics provider ----
DEFAULT_ANALYTICS_PROVIDER=mock
ANALYTICS_API_KEY=

# ---- Security / rate limiting ----
# mock and memory are local/test only. Configure external before multi-instance production use.
DEFAULT_RATE_LIMIT_PROVIDER=mock
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_API_URL=
RATE_LIMIT_API_TOKEN=
RATE_LIMIT_PROVIDER_TIMEOUT_MS=3000

# ---- Cost tracking ----
AI_COST_TRACKING_ENABLED=true

# ---- Launch metadata ----
LEGAL_EFFECTIVE_DATE=2026-07-23
SUPPORT_EMAIL=support@marketra.example
BUILD_VERSION=development

# ---- E2E test credentials ----
# Three isolated Supabase users for authenticated Playwright projects.
# Each user prevents a sign-out in one project from revoking another project's token.
# Real values go in .env.local only.
E2E_DESKTOP_USER_EMAIL=
E2E_DESKTOP_USER_PASSWORD=
E2E_MOBILE_USER_EMAIL=
E2E_MOBILE_USER_PASSWORD=
E2E_SIGNOUT_USER_EMAIL=
E2E_SIGNOUT_USER_PASSWORD=
